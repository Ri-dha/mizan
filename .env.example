# Copied to .env by docker compose. Every value here is a dev default; deployed environments
# supply real secrets from their secrets manager.
POSTGRES_DB=mizan
POSTGRES_USER=mizan
POSTGRES_PASSWORD=mizan

# Object storage (SeaweedFS) credentials, shared by the store, the API and the backup job.
# The old MINIO_ROOT_USER / MINIO_ROOT_PASSWORD names are still read if these are unset.
MIZAN_STORAGE_ACCESS_KEY=mizan
MIZAN_STORAGE_SECRET_KEY=mizan-dev-secret
# The address browsers and phones use for receipts, normally the site itself (https://<SITE_ADDRESS>),
# which Caddy forwards to storage. Blank in development: links use http://localhost:8333.
MIZAN_STORAGE_PUBLIC_ENDPOINT=

MIZAN_JWT_SECRET=dev-only-secret-change-me-in-every-real-environment
MIZAN_HASH_PEPPER=dev-only-pepper-change-me

# --- Production profile ---
# SPRING_PROFILES_ACTIVE=prod turns off stub prices and Swagger and reads every secret from here.
SPRING_PROFILES_ACTIVE=dev
# Public host for automatic TLS, e.g. mizan.example.iq; ":80" when another proxy terminates TLS.
SITE_ADDRESS=:80
# An extra origin the Content-Security-Policy allows for storage. Blank: storage is served by the
# site itself (ADR storage-4), which is how a deployment runs.
MIZAN_STORAGE_ORIGIN=
MIZAN_ALLOWED_ORIGINS=
MIZAN_PARALLEL_RATE_IQD_MICROS=0
# IQWealth (iraqsm.com) Baghdad market and Central Bank dollar. A free key is personal and
# non-commercial only and needs the "Data: IQWealth" credit; public deployments need the Business
# plan. Blank turns it off. Side: BUY, SELL or MID.
# Operators (ADR admin-1): the first operator's email or phone, and the key that encrypts
# secrets saved in the dashboard (32 random bytes, base64: `openssl rand -base64 32`).
MIZAN_BOOTSTRAP_OPERATOR=
MIZAN_SETTINGS_KEY=
MIZAN_IQWEALTH_API_KEY=
MIZAN_IQWEALTH_PARALLEL_SIDE=MID
MIZAN_METALS_DEV_API_KEY=
MIZAN_GOLD_API_KEY=
MIZAN_OPEN_EXCHANGE_RATES_APP_ID=
MIZAN_EXCHANGE_RATE_API_URL=https://open.er-api.com
# Keyless spot source, on by default; set false to rely on keyed providers only.
MIZAN_GOLD_API_COM_ENABLED=true
# Baghdad Bullion House bid/ask per gram and product list; the default local source.
MIZAN_BAGHDAD_BULLION_URL=https://prices.baghdadbullionhouse.com/api/prices
MIZAN_BAGHDAD_BULLION_ENABLED=true
# Feeds are called on request only unless this is true.
MIZAN_MARKET_AUTO_REFRESH=false
# Web Push (docs/RUNBOOK.md "Push notifications"); blank means a per-run pair in dev.
MIZAN_VAPID_SUBJECT=mailto:admin@example.iq
MIZAN_VAPID_PUBLIC_KEY=
MIZAN_VAPID_PRIVATE_KEY=
# Local dealer price feed (docs/RUNBOOK.md "Local dealer price feed"); blank disables it.
MIZAN_LOCAL_DEALER_URL=
MIZAN_LOCAL_DEALER_GOLD_PATH=gold
MIZAN_LOCAL_DEALER_GOLD_UNIT=MITHQAL_21K
MIZAN_LOCAL_DEALER_SILVER_PATH=
MIZAN_LOCAL_DEALER_SILVER_UNIT=GRAM_999
# --- Observability (docker compose --profile observability up -d) ---
ELASTIC_VERSION=9.3.3
ES_JAVA_OPTS=-Xms512m -Xmx512m
KIBANA_ENCRYPTION_KEY=change-me-to-32-or-more-characters!!
# Days Elasticsearch keeps each kind of index before deleting it (ADR obs-2).
MIZAN_LOG_RETENTION_DAYS=14
MIZAN_CONTAINER_LOG_RETENTION_DAYS=7
MIZAN_METRICS_RETENTION_DAYS=7
# The API pushes JVM/HTTP metrics to Elasticsearch when true (on in the api container).
# Monitoring (ADR obs-5). Grafana on http://localhost:3000 (admin), Uptime Kuma on :3001.
MIZAN_GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Where VictoriaMetrics reads the API's metrics; host.docker.internal:8080 for an API run outside Docker.
MIZAN_API_METRICS_TARGET=api:8080
MIZAN_METRICS_RETENTION=30d
# Alerts go to Telegram when both are set (a bot from @BotFather and the chat's numeric id).
MIZAN_ALERT_TELEGRAM_BOT_TOKEN=
MIZAN_ALERT_TELEGRAM_CHAT_ID=
# The Uptime Kuma push URL the nightly backup calls after a good dump.
BACKUP_PUSH_URL=
BACKUP_BUCKET=mizan-backups
# Nightly database dumps kept: the newest N, then the newest of each of M weeks before them.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
