# Copied to .env by docker compose. Every value here is a dev default; deployed environments
# supply real secrets from their secrets manager.
POSTGRES_DB=mizan
POSTGRES_USER=mizan
POSTGRES_PASSWORD=mizan

MINIO_ROOT_USER=mizan
MINIO_ROOT_PASSWORD=mizan-dev-secret

MIZAN_JWT_SECRET=dev-only-secret-change-me-in-every-real-environment
MIZAN_HASH_PEPPER=dev-only-pepper-change-me

# --- Production profile ---
# SPRING_PROFILES_ACTIVE=prod turns off stub prices and Swagger and reads every secret from here.
SPRING_PROFILES_ACTIVE=dev
# Public host for automatic TLS, e.g. mizan.example.iq; ":80" when another proxy terminates TLS.
SITE_ADDRESS=:80
MIZAN_ALLOWED_ORIGINS=
MIZAN_PARALLEL_RATE_IQD_MICROS=0
MIZAN_METALS_DEV_API_KEY=
MIZAN_GOLD_API_KEY=
MIZAN_OPEN_EXCHANGE_RATES_APP_ID=
MIZAN_EXCHANGE_RATE_API_URL=https://open.er-api.com
# Keyless spot source, on by default; set false to rely on keyed providers only.
MIZAN_GOLD_API_COM_ENABLED=true
# Baghdad Bullion House bid/ask per gram and product list; the default local source.
MIZAN_BAGHDAD_BULLION_URL=https://prices.baghdadbullionhouse.com/api/prices
MIZAN_BAGHDAD_BULLION_ENABLED=true
# Feeds are called on request only unless this is true.
MIZAN_MARKET_AUTO_REFRESH=false
# Web Push (docs/RUNBOOK.md "Push notifications"); blank means a per-run pair in dev.
MIZAN_VAPID_SUBJECT=mailto:admin@example.iq
MIZAN_VAPID_PUBLIC_KEY=
MIZAN_VAPID_PRIVATE_KEY=
# Local dealer price feed (docs/RUNBOOK.md "Local dealer price feed"); blank disables it.
MIZAN_LOCAL_DEALER_URL=
MIZAN_LOCAL_DEALER_GOLD_PATH=gold
MIZAN_LOCAL_DEALER_GOLD_UNIT=MITHQAL_21K
MIZAN_LOCAL_DEALER_SILVER_PATH=
MIZAN_LOCAL_DEALER_SILVER_UNIT=GRAM_999
# --- Observability (docker compose --profile observability up -d) ---
ELASTIC_VERSION=9.3.3
ES_JAVA_OPTS=-Xms512m -Xmx512m
LS_JAVA_OPTS=-Xms256m -Xmx512m
KIBANA_ENCRYPTION_KEY=change-me-to-32-or-more-characters!!
# The API pushes JVM/HTTP metrics to Elasticsearch when true (on in the api container).
MIZAN_METRICS_ELASTIC_ENABLED=false
MIZAN_ELASTICSEARCH_URL=http://localhost:9200
BACKUP_BUCKET=mizan-backups
BACKUP_RETENTION_DAYS=30
