# Copied to .env by docker compose. Every value here is a dev default; deployed environments
# supply real secrets from their secrets manager.
POSTGRES_DB=mizan
POSTGRES_USER=mizan
POSTGRES_PASSWORD=mizan

MINIO_ROOT_USER=mizan
MINIO_ROOT_PASSWORD=mizan-dev-secret

MIZAN_JWT_SECRET=dev-only-secret-change-me-in-every-real-environment
MIZAN_HASH_PEPPER=dev-only-pepper-change-me
