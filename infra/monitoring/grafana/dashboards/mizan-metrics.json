{
 "uid": "mizan-metrics",
 "title": "Mizan metrics",
 "tags": [
  "mizan"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "1m",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second by status",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"api\"}[$__rate_interval]))",
     "legendFormat": "{{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latency: p95 and average",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"api\"}[$__rate_interval])))",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(rate(http_server_requests_seconds_sum{job=\"api\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"api\"}[$__rate_interval]))",
     "legendFormat": "average"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "5xx share of requests",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(rate(http_server_requests_seconds_count{job=\"api\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"api\"}[$__rate_interval])), 1e-9)",
     "legendFormat": "5xx"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Slowest paths (average)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "topk(5, sum by (method, uri) (rate(http_server_requests_seconds_sum{job=\"api\"}[$__rate_interval])) / sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"api\"}[$__rate_interval])))",
     "legendFormat": "{{method}} {{uri}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "API heap used and max",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(jvm_memory_used_bytes{job=\"api\",area=\"heap\"})",
     "legendFormat": "used"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum(jvm_memory_max_bytes{job=\"api\",area=\"heap\"})",
     "legendFormat": "max"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Database connections (Hikari)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "max(hikaricp_connections_active{job=\"api\"})",
     "legendFormat": "active"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "max(hikaricp_connections_idle{job=\"api\"})",
     "legendFormat": "idle"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "max(hikaricp_connections_pending{job=\"api\"})",
     "legendFormat": "waiting"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Container memory",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "max by (name) (container_memory_working_set_bytes{job=\"containers\"})",
     "legendFormat": "{{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Container CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"containers\"}[$__rate_interval]))",
     "legendFormat": "{{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Disk free",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "min by (mountpoint) (node_filesystem_avail_bytes{job=\"host\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"host\",fstype!~\"tmpfs|overlay\"})",
     "legendFormat": "{{mountpoint}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Postgres connections",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 8,
    "y": 32,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sum by (state) (pg_stat_activity_count)",
     "legendFormat": "{{state}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "stat",
   "title": "IQWealth requests left today",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 16,
    "y": 32,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "max(mizan_iqwealth_remaining_requests{job=\"api\"})",
     "legendFormat": "left"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "stat",
   "title": "Up",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "up",
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ]
}