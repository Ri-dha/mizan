{
  "index_patterns": ["containers-logs-*"],
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0, "index.mapping.ignore_malformed": true, "index.mapping.total_fields.limit": 2000 },
    "mappings": {
      "dynamic_templates": [
        { "strings_as_keywords": { "match_mapping_type": "string", "mapping": { "type": "keyword", "ignore_above": 1024 } } }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
        "container_id": { "type": "keyword" },
        "stream": { "type": "keyword" }
      }
    }
  },
  "priority": 200
}
